# Required.
JITSI_DOMAIN=meet.example.org

# Optional. Leave empty if the server is not behind NAT. If PUBLIC_IP is empty,
# the installer tries to detect it. If PRIVATE_IP is empty, the installer uses
# the primary local address.
PUBLIC_IP=
PRIVATE_IP=

# selfsigned or letsencrypt. Use letsencrypt only with real DNS and reachable
# ports 80/443.
TLS_MODE=selfsigned
LE_EMAIL=admin@example.org

# Default production profile, relative to this config file. Fresh installs use
# Java 21 Generational ZGC with an 8 GB fixed heap and rolling JFR diagnostics.
# profiles/jvb-g1-120.env remains available for explicit comparison tests.
JVB_PROFILE_FILE=profiles/jvb-zgc-120.env

# Base values mirror the default ZGC profile and also apply when a custom config
# intentionally leaves JVB_PROFILE_FILE empty. Keep equal Xms/Xmx.
JVB_HEAP=8g
JVB_GC_PROFILE=zgc
JVB_JFR_ENABLED=true
JVB_G1_MAX_PAUSE_MS=50
JVB_G1_RESERVE_PERCENT=20
JVB_JFR_MAXAGE=2h
JVB_JFR_MAXSIZE=1g
# Bridge-wide video forwarding cap. Endpoints can request a lower value but
# cannot exceed this value.
JVB_LAST_N=16
JICOFO_HEAP=1g

# Official Jitsi Debian repository artifact source.
JITSI_REPO_URL=https://download.jitsi.org/stable

# Package names from the Jitsi repo.
JITSI_PACKAGES="jitsi-meet-web jitsi-meet-prosody jicofo jitsi-videobridge2"

# Safety: abort if potentially conflicting services are already active.
ALLOW_EXISTING_SERVICES=false

# Keep XMPP and BOSH/WebSocket behind Nginx by default. Only expose these for
# admin/debug labs where the firewall scope is controlled.
EXPOSE_XMPP_PORTS=false

# Grafana admin bootstrap. Change this before a shared lab.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Pinned official Prometheus exporter releases used by detailed JVB monitoring.
NODE_EXPORTER_VERSION=1.11.1
JMX_EXPORTER_VERSION=1.6.0

# Generated automatically if left empty.
JICOFO_AUTH_PASSWORD=
JVB_AUTH_PASSWORD=
