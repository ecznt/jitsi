    {
      "id": 15,
      "type": "timeseries",
      "title": "JVB Load Shape",
      "description": "CPU cost follows forwarded streams, packet rate and bitrate more closely than conference count alone.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
