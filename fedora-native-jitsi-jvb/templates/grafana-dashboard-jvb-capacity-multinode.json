    {
      "id": 12,
      "type": "timeseries",
      "title": "Packets and CPU Efficiency",
      "description": "Packets per process CPU second is a workload-specific efficiency indicator. Compare only like-for-like codecs, bitrate, LastN and participant behavior.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(jitsi_jvb_packets_received_total{job=\"jvb\",jvb_node=~\"$jvb_node\"}[1m])) + sum(rate(jitsi_jvb_packets_sent_total{job=\"jvb\",jvb_node=~\"$jvb_node\"}[1m]))",
          "legendFormat": "media packets/s",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(jitsi_jvb_packets_received_total{job=\"jvb\",jvb_node=~\"$jvb_node\"}[1m])) + sum(rate(jitsi_jvb_packets_sent_total{job=\"jvb\",jvb_node=~\"$jvb_node\"}[1m]))) / clamp_min(sum(rate(process_cpu_seconds_total{job=\"jvb-jmx\",jvb_node=~\"$jvb_node\"}[1m])), 0.01)",
          "legendFormat": "packets / CPU second",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Network Throughput",
      "description": "Serious JVB capacity tests should verify NIC bandwidth and packets/s, not CPU alone.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "min": 0
        },
        "overrides": []
