        {
          "expr": "8 * sum(rate(node_network_transmit_bytes_total{job=\"node\",jvb_node=~\"$jvb_node\",device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "transmit",
          "refId": "B"
        }
