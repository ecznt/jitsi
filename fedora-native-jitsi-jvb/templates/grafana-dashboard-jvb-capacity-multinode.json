      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "8 * sum(rate(node_network_receive_bytes_total{job=\"node\",jvb_node=~\"$jvb_node\",device!~\"lo|docker.*|veth.*\"}[1m]))",
          "legendFormat": "receive",
          "refId": "A"
