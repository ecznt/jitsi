          "expr": "sum(rate(node_softnet_processed_total{job=\"node\",jvb_node=~\"$jvb_node\"}[1m]))",
          "legendFormat": "softnet processed/s",
          "refId": "B"
        },
        {
          "expr": "sum(rate(node_softnet_times_squeezed_total{job=\"node\",jvb_node=~\"$jvb_node\"}[1m]))",
          "legendFormat": "softnet squeezed/s",
