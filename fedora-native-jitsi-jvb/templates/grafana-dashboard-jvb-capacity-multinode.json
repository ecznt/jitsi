            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "rate(node_context_switches_total{job=\"node\",jvb_node=~\"$jvb_node\"}[1m])",
          "legendFormat": "context switches/s",
