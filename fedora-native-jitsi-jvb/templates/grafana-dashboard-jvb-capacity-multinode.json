{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Host Logical CPUs",
      "description": "Count observed by Node Exporter. Compare with Runtime.availableProcessors in the incident bundle/JVM startup log.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "count(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"})",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "JVB CPU Cores Used",
      "description": "process_cpu_seconds_total rate: 1.0 means one fully occupied logical CPU.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total{job=\"jvb-jmx\",jvb_node=~\"$jvb_node\"}[1m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "JVB CPU / Host Capacity",
      "description": "Normalized process CPU. On 48 logical CPUs, 100 percent represents all 48 CPUs.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 87.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "100 * sum(rate(process_cpu_seconds_total{job=\"jvb-jmx\",jvb_node=~\"$jvb_node\"}[1m])) / count(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"})",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "JVB Stress",
      "description": "Bridge load manager signal. Keep the configured overload threshold and recovery threshold visible during tuning.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 0.72
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "max(jitsi_jvb_stress_level{job=\"jvb\",jvb_node=~\"$jvb_node\"})",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Local Endpoints",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(jitsi_jvb_local_endpoints{job=\"jvb\",jvb_node=~\"$jvb_node\"})",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Media Packets / Second",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "expr": "sum(rate(jitsi_jvb_packets_received_total{job=\"jvb\",jvb_node=~\"$jvb_node\"}[1m])) + sum(rate(jitsi_jvb_packets_sent_total{job=\"jvb\",jvb_node=~\"$jvb_node\"}[1m]))",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Per-CPU Utilization",
      "description": "A few saturated CPUs with idle peers points to IRQ affinity, RSS imbalance, serialization or a hot queue rather than lack of total cores.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "100 * (1 - avg by (cpu) (rate(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"}[1m])))",
          "legendFormat": "CPU {{cpu}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Host CPU Modes",
      "description": "softirq growth implicates packet processing; iowait implicates storage/logging; steal should be near zero on a physical host.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "100 * avg by (mode) (rate(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=~\"user|system|softirq|irq|iowait|steal\"}[1m]))",
          "legendFormat": "{{mode}}",
          "refId": "A"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVB CPU Cores vs Host Capacity",
      "description": "The capacity line is dynamic; do not read process CPU as a single-core percentage.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(process_cpu_seconds_total{job=\"jvb-jmx\",jvb_node=~\"$jvb_node\"}[1m]))",
          "legendFormat": "JVB cores used",
          "refId": "A"
        },
        {
          "expr": "count(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"})",
          "legendFormat": "logical CPU capacity",
          "refId": "B"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Load and Run Queue per CPU",
      "description": "Values persistently near/above 1 mean runnable work is competing for CPUs.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "expr": "node_load1{job=\"node\",jvb_node=~\"$jvb_node\"} / scalar(count(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"}))",
          "legendFormat": "load1 / CPU",
          "refId": "A"
        },
        {
          "expr": "node_load5{job=\"node\",jvb_node=~\"$jvb_node\"} / scalar(count(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"}))",
          "legendFormat": "load5 / CPU",
          "refId": "B"
        },
        {
          "expr": "sum(node_procs_running{job=\"node\",jvb_node=~\"$jvb_node\"}) / scalar(count(node_cpu_seconds_total{job=\"node\",jvb_node=~\"$jvb_node\",mode=\"idle\"}))",
          "legendFormat": "run queue / CPU",
          "refId": "C"
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scheduler and Softnet Work",
      "description": "Correlate context switches with JVB thread growth; correlate softnet pressure with packet loss.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 13
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
