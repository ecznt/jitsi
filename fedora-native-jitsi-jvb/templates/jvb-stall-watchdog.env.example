# Three consecutive samples are required before a bundle is captured.
JVB_WATCHDOG_CONSECUTIVE_LIMIT=3
JVB_WATCHDOG_COOLDOWN_SECONDS=900

# A zero thread limit disables absolute thread-count triggering. Establish the
# normal production baseline first, then set this above the observed P99.
JVB_WATCHDOG_THREAD_LIMIT=0
JVB_WATCHDOG_BLOCKED_THREAD_LIMIT=8

# The watchdog normalizes process CPU seconds against the host's logical CPU
# count. 87.5 percent is equivalent to roughly 42 fully used cores on a
# 48-logical-CPU host.
JVB_WATCHDOG_CPU_PERCENT_LIMIT=87.5
JVB_WATCHDOG_STRESS_LIMIT=0.90
# Requires videobridge.stats.transit-time.enable-prometheus=true. NaN/no traffic
# is treated as zero and does not trigger a bundle.
JVB_WATCHDOG_TRANSIT_P99_MS_LIMIT=100

# Approximately seven days at a 15-second interval. The file is compacted only
# after it grows to twice this value, avoiding a rewrite on every sample.
JVB_WATCHDOG_MAX_SAMPLE_LINES=40320
JVB_THREAD_DUMP_COUNT=3
JVB_THREAD_DUMP_INTERVAL_SECONDS=5
JVB_INCIDENT_JFR_MAX_AGE=10m
JVB_INCIDENT_JOURNAL_SINCE='-10 minutes'

# Debian/Ubuntu package installs normally use jitsi-videobridge2. Leave empty
# to auto-detect jitsi-videobridge2 or jitsi-videobridge.
JVB_SERVICE=
